// 計画の契約のひな形。作業ディレクトリに plan.jsonc という名前で写して埋める。
// run-contract.jsonc (走行中の正本) の計画版で、欄が埋まっているかは scripts/check-plan.py が確かめる。
//
//   python3 "${CLAUDE_PLUGIN_ROOT}/scripts/check-plan.py" <作業ディレクトリ>
//
// 書き方の決まり:
//   - 空欄は書かない。該当しない欄は「該当なし: 理由」と書く (理由の無い「該当なし」は検査が落とす)
//   - 末尾カンマは書かない (Stop hook が読めなくなる)
//   - 計画書の HTML には、欄ごとに対応する節を作る (節の見出しの言葉は check-plan.py の SECTIONS)
//   - 工数も日付も書かない (references/priorities.md の順位とは別の決まり)
{
  // ---- 結論と読み手 ----
  // text には、あるべき状態を 1 文で書き、今回の変更をそこへの距離として説明する
  "summary": {
    "text": "結論を 1〜2 文",
    "reader": "誰が読むか"
  },

  // ---- 現状 ----
  // measured は実測したものだけを、前後の数字で書く。机上で読めていない・測っていないものは
  // 数字を作らず「該当なし: 実測していない。着手時に測る」と書く。read_at も同じ (読んでいなければ「該当なし: 理由」)。
  // 各結論に「実データで確認 / コードで確認 (file:line) / 未検証」のどれかを付ける。
  // 今の作りに違和感がある箇所を「既存だから」で温存しない。温存するなら理由を数字で書く
  "current": {
    "measured": ["実際に測った数字 (前後の数字で書く)"],
    "read_at": "読んだリポジトリのブランチとコミット"
  },

  // ---- どの案もこれに照らして比べる条件 ----
  "conditions": ["条件 1"],

  // ---- 決まったこと。by は「ユーザー」か「暫定」 ----
  // 「暫定」にしてよいのは、外れても計画を直せば済む分岐と、本人しか知らない情報が絡まない設計判断 (priorities.md の順位で決める)。
  // 本人しか知らない・判断権限が要る分岐 (顧客への出し方や先に出す相手、お金、外部への公開) は暫定で決めず undecided に入れる。
  // 依頼の読み方が割れるときは、コード・リポジトリから最有力の解釈を暫定で決め、選ばなかった解釈と選んだ理由を書き、run-contract.jsonc の questions_parked にも積む。
  // 依頼者の意図の解釈は、外れても計画を直せば済むなら undecided に入れない
  "decided": [
    { "what": "決めたこと", "by": "ユーザー" }
  ],

  // ---- 新しく足す処理・判断の置き場。1 つの処理・判断につき 1 行 ----
  // where は「どの層の、どの型・関数か」。入口 (main・handler・cmd) に業務ルールを置かない。
  //   判断材料を全部持っている型 (値オブジェクト・エンティティ・ドメインのサービス) があるなら、そこに置く
  // precedent は、同じ層にある兄弟 (ほかの実行ファイル・同種の機能) がどこに置いているか、何を import しているかを数えた結果。
  //   前例と違う置き方を選ぶなら、その理由も書く。層をまたいで借りるために組み立てを手で写すことになったら、置き場を疑う
  // other_entries は、同じ共有コードを通るほかの経路 (別の handler・別の worker など) のうち、同じ問題を抱えるもの。
  //   あるなら、守りを共通の層に置いて両方を守る。無いなら「該当なし: 理由」と書く
  // 足す処理が 1 つも無い計画は、what に「該当なし: 理由」を書いた 1 行だけでよい (残りのキーは省く)
  "placement": [
    { "what": "足す処理・判断", "where": "置く層と型・関数", "precedent": "兄弟の前例と、それに倣うか", "other_entries": "同じ共有コードを通るほかの経路" }
  ],

  // ---- どう壊れうるかと、その守り方。1 つの壊れ方につき 1 行 ----
  // 少なくとも次を 1 つずつ当てる。当たらないものは、case に「該当なし: 理由」を書いた 1 行にする (guard と pinned_by は省く)
  //   - 同じ入力が 2 回届く (再配信・再試行) / 2 本が同時に届く / 順番が入れ替わって届く
  //   - 途中で失敗したとき、書きかけの状態が残る (複数の書き込みを 1 つのトランザクションに入れたか。
  //     読んで判定してから書くなら、読む時点でロックを取っているか)
  //   - 判定できない入力が既定値に落ちる (その既定値が何を意味するかを読んだか。
  //     入力を作る側 (上流) のコードを読み、実際に届く値を確かめたか)
  //   - 兄弟プロダクトが同じ問題をどう扱っているか (揃えるか、揃えないならその理由)
  // guard は守り方。pinned_by は、その守りを何で固定するか (テスト・型・シグネチャ)。
  //   コメントだけでは固定にならない。守りを壊したらテストが落ちる形にする
  "failure_modes": [
    { "case": "壊れ方", "guard": "守り方", "pinned_by": "守りを固定するテストや型" }
  ],

  // ---- PR ごとの変更 ----
  // 各 PR は「〜と〜」で 2 つの概念をつながずに 1 文で言える形にする。同じ関心事を機械的に割らない
  "prs": [
    { "title": "PR の題", "changes": "その PR で変わること" }
  ],

  // ---- 出す順番。図で書く ----
  // if_reversed は、隣り合う 2 本を入れ替えたときに壊れる組だけを書く (全部の組み合わせは並べない)
  "release": {
    "order": ["1 本の通し順"],
    "migration": "マイグレーションの有無と危険度",
    "if_reversed": "逆の順にすると何が壊れるか",
    "rollback": "戻し方",
    "visible_midway": "途中まで入った状態で顧客に見えるもの"
  },

  // ---- 影響が及ぶ先。連携しているサービスと兄弟プロダクトを 1 つずつ並べる ----
  // 並べるべき名前の一覧は利用者の設定から読む (check-plan.py の --targets / ENV / 導入時の入力)。
  // このファイルには案件名を書かない。
  // このあと控えている施策とぶつからないかも、target に施策名を入れて 1 行書く。
  // 事実を確認できない対象は、affected を暫定で決めたうえで why に「未確認: 何が分かれば確定するか」と書く。
  // その事実が分かると出す順番や中身が変わるもの (自分では確かめられない外部の状態) は、undecided にも入れる。変わらないものは why だけでよい
  "impact": [
    { "target": "サービス名", "affected": false, "why": "影響あり / なしの理由" }
  ],

  // ---- 外したもの ----
  "not_doing": ["やらないこと: 理由"],

  // ---- 出したあと ----
  "after": {
    "verify": "出したあとに確かめること",
    "cleanup": "あとで消すもの",
    "notice": "知らせる相手と内容",
    "other_teams": "他チームに頼むこと"
  },

  // ---- 却下した案。why は priorities.md の順位のどれに負けたかで書く ----
  "rejected": [
    { "option": "却下した案", "why": "優先順位の 2 位 (長期の保守性) に負けた" }
  ],

  // ---- 自分では確かめられないものだけ。自分で読む・測る・試作すれば分かることは入れない。1 件でも残れば実装に進まず止まる ----
  // 外れても計画を直せば済む「依頼の解釈」は入れない (decided の暫定にする)。入れるのは、外れると取り返しがつかないものと、本人しか知らない事実
  // 1 件の形: { "q": "決まっていないこと", "why_not_me": "本人しか知らない" }
  // why_not_me は「本人しか知らない」「外部の状態」「判断権限が要る」のどれか
  "undecided": [],

  // confidence が 90 未満なら、まず自分で確かめて上げる (読む・測る・試作する)。結論に「未検証」が残っているうちは 90 以上を付けない。
  // 自分では確かめられないもの (本人しか知らない・外部の状態・判断権限が要る) だけを undecided に書く

  "confidence": 85
}

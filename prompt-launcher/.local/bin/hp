#!/usr/bin/env bash
# hp (herdr prompt) - プロンプトの保管・取り出し・稼働中 Claude セッションへの注入
#
# プロンプトは「1 行 = 1 プロンプト」のテキストファイルに置く。
# 空行と # 始まりの行は無視するので、コメントで区切って整理できる。
# 指定は行番号（hp list が表示する番号 = ファイル上の行番号）で行う。
set -euo pipefail

# ===== プロンプトファイル =====
# repo には置かない（個人の書きかけを版管理に載せないため）。
prompts_file="${HP_PROMPT_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/hp/prompts.txt}"

# ===== 共通ヘルパー =====
err() {
  echo "hp: $*" >&2
  # popup は一瞬で閉じてメッセージが読めないため、HP_LOG があれば控えを残す
  if [ -n "${HP_LOG:-}" ]; then
    printf '%s hp: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >> "$HP_LOG" 2>/dev/null || true
  fi
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || { err "コマンドが見つかりません: $1"; exit 1; }
}

# 端末が開けるか（popup 内では stdin がパイプのことがあるため常に /dev/tty を使う）
has_tty() {
  (exec < /dev/tty) 2>/dev/null
}

# 端末から 1 行読む。読めた内容を標準出力へ返す（プロンプト表示は stderr）
read_tty() {
  local label="$1" line=""
  printf '%s' "$label" >&2
  read -r line < /dev/tty || true
  printf '%s' "$line"
}

# 初期値入りで 1 行読む（readline 編集つき）。エディタを開かずに直せるようにするため。
# bash 4 未満は read -i が無いので、現在値を見せて打ち直してもらう。
read_tty_edit() {
  local label="$1" init="$2" line=""
  if [ "${BASH_VERSINFO[0]:-3}" -ge 4 ]; then
    read -e -i "$init" -r -p "$label" line < /dev/tty || true
  else
    err "現在値: $init"
    line=$(read_tty "$label")
  fi
  printf '%s' "$line"
}

ensure_file() {
  local dir
  dir=$(dirname "$prompts_file")
  mkdir -p "$dir"
  if [ ! -f "$prompts_file" ]; then
    {
      echo "# hp のプロンプト置き場。1 行 = 1 プロンプト。"
      echo "# 空行と # 始まりの行は無視される。"
    } > "$prompts_file"
    err "プロンプトファイルを作成しました: $prompts_file"
  fi
}

# 有効な行を「行番号<TAB>本文」で出力する。空行と # 始まりは飛ばす。
entries() {
  [ -f "$prompts_file" ] || return 0
  awk 'NF && $0 !~ /^[[:space:]]*#/ { printf "%d\t%s\n", NR, $0 }' "$prompts_file"
}

# 行番号として妥当か
validate_index() {
  local n="$1"
  case "$n" in
    ""|*[!0-9]*)
      err "行番号で指定してください（hp list で確認）: $n"
      exit 1
      ;;
  esac
  [ "$n" -gt 0 ] || { err "行番号は 1 以上です: $n"; exit 1; }
}

# 行番号 -> 本文。無効な行（空行・コメント・範囲外）ならエラーで止める。
line_body() {
  local n="$1"
  validate_index "$n"
  if [ ! -f "$prompts_file" ]; then
    err "プロンプトファイルがありません: $prompts_file"
    exit 1
  fi
  local body
  body=$(awk -v n="$n" 'NR == n { print; exit }' "$prompts_file")
  if [ -z "$body" ]; then
    err "その行にプロンプトがありません: $n"
    exit 1
  fi
  case "$body" in
    [[:space:]]*#*|\#*)
      err "その行はコメントです: $n"
      exit 1
      ;;
  esac
  printf '%s' "$body"
}

# ===== 参照系 =====
cmd_list() {
  local out
  out=$(entries)
  if [ -z "$out" ]; then
    err "プロンプトがありません ($prompts_file)"
    return 0
  fi
  printf '%s\n' "$out"
}

cmd_show() {
  local body
  body=$(line_body "$1")
  printf '%s\n' "$body"
}

cmd_copy() {
  require_cmd pbcopy
  local body
  body=$(line_body "$1")
  printf '%s' "$body" | pbcopy
  err "クリップボードにコピーしました: $1"
}

# ===== 編集系 =====
# 追加・書き換えの共通チェック。正規化した本文を標準出力へ返す。
prepare_text() {
  local text="$*"
  # 前後の空白を削る
  text="${text#"${text%%[![:space:]]*}"}"
  text="${text%"${text##*[![:space:]]}"}"
  if [ -z "$text" ]; then
    err "本文が空です"
    exit 1
  fi
  case "$text" in
    \#*)
      err "# で始まる行はコメントとして無視されるため使えません"
      exit 1
      ;;
  esac
  case "$text" in
    *"
"*)
      err "改行を含むプロンプトは使えません（1 行 = 1 プロンプト）"
      exit 1
      ;;
  esac
  printf '%s' "$text"
}

# 同じ本文がある行番号を返す（無ければ空）。第 2 引数の行は照合から除く。
find_dup() {
  local text="$1" skip="${2:-0}"
  entries | text="$text" skip="$skip" awk -F'\t' \
    '$1 != ENVIRON["skip"] && $2 == ENVIRON["text"] { print $1; exit }'
}

# n 行目を text に差し替える
replace_line() {
  local n="$1" text="$2" tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/hp.XXXXXX")
  n="$n" text="$text" awk \
    'NR == ENVIRON["n"] { print ENVIRON["text"]; next } { print }' "$prompts_file" > "$tmp"
  mv "$tmp" "$prompts_file"
}

cmd_add() {
  local text
  text=$(prepare_text "$@")
  ensure_file
  local dup
  dup=$(find_dup "$text")
  if [ -n "$dup" ]; then
    err "同じプロンプトが既にあります（行 ${dup}）: $text"
    exit 1
  fi

  # 末尾に改行が無いファイルへ追記しても行が繋がらないようにする
  if [ -s "$prompts_file" ] && [ "$(tail -c1 "$prompts_file" | wc -l | tr -d ' ')" = "0" ]; then
    printf '\n' >> "$prompts_file"
  fi
  printf '%s\n' "$text" >> "$prompts_file"
  local n
  n=$(wc -l < "$prompts_file" | tr -d ' ')
  err "追加しました（行 ${n}）: $text"
}

# 行の本文を書き換える（エディタを開かずに直す用）
cmd_set() {
  local n="$1"
  shift
  local old text dup
  old=$(line_body "$n")
  text=$(prepare_text "$@")
  if [ "$text" = "$old" ]; then
    err "変更はありません（行 ${n}）"
    return 0
  fi
  dup=$(find_dup "$text" "$n")
  if [ -n "$dup" ]; then
    err "同じプロンプトが既にあります（行 ${dup}）: $text"
    exit 1
  fi
  replace_line "$n" "$text"
  err "書き換えました（行 ${n}）: $text"
}

cmd_edit() {
  ensure_file
  local editor="${HP_EDITOR:-${VISUAL:-${EDITOR:-nvim}}}"
  # "code -w" のように引数付きを許すため、あえて単語分割させて起動する
  # shellcheck disable=SC2086
  set -- $editor
  require_cmd "$1"
  # shellcheck disable=SC2086
  $editor "$prompts_file"
  err "編集しました: $prompts_file"
}

cmd_rm() {
  local n="$1"
  local body
  body=$(line_body "$n")
  if ! has_tty; then
    err "確認できる端末がないため中止しました（行 ${n}）"
    exit 1
  fi
  local ans
  ans=$(read_tty "削除しますか？ 行 $n: $body [y/N] ")
  case "$ans" in
    y|Y|yes|YES) ;;
    *)
      err "中止しました（行 ${n}）"
      exit 1
      ;;
  esac
  local tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/hp.XXXXXX")
  awk -v n="$n" 'NR != n' "$prompts_file" > "$tmp"
  mv "$tmp" "$prompts_file"
  err "削除しました（行 ${n}）: $body"
}

# ===== 送信先解決 =====
# resolve_target: 標準出力に terminal_id を返す。参考情報（経路等）は stderr に出す。
resolve_target() {
  require_cmd herdr
  require_cmd jq

  local agents
  if ! agents=$(herdr agent list 2>/dev/null); then
    err "herdr に接続できません（herdr agent list に失敗）"
    exit 1
  fi

  # 手順1: HERDR_ACTIVE_PANE_ID から agent get
  if [ -n "${HERDR_ACTIVE_PANE_ID:-}" ]; then
    local get_json
    if get_json=$(herdr agent get "$HERDR_ACTIVE_PANE_ID" 2>/dev/null); then
      local is_claude terminal_id
      is_claude=$(echo "$get_json" | jq -r '.result.agent.agent // empty')
      if [ "$is_claude" = "claude" ]; then
        terminal_id=$(echo "$get_json" | jq -r '.result.agent.terminal_id // empty')
        if [ -n "$terminal_id" ]; then
          err "解決経路: 1 (HERDR_ACTIVE_PANE_ID -> agent get)"
          printf '%s' "$terminal_id"
          return 0
        fi
      fi
    fi
  fi

  # 手順2: agent list を workspace_id で絞り込み
  local ws="${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}"
  if [ -n "$ws" ]; then
    local candidates count terminal_id
    candidates=$(echo "$agents" | jq -r --arg ws "$ws" \
      '.result.agents[] | select(.agent=="claude" and .workspace_id==$ws)')
    count=$(echo "$candidates" | jq -s 'length')
    if [ "$count" -gt 0 ]; then
      # origin pane と一致するものを優先
      if [ -n "${HERDR_ACTIVE_PANE_ID:-}" ]; then
        terminal_id=$(echo "$candidates" | jq -r --arg pane "$HERDR_ACTIVE_PANE_ID" \
          'select(.pane_id==$pane) | .terminal_id' | head -n1)
        if [ -n "$terminal_id" ]; then
          err "解決経路: 2 (agent list -> workspace 絞り込み -> pane 一致)"
          printf '%s' "$terminal_id"
          return 0
        fi
      fi
      if [ "$count" -gt 1 ]; then
        err "workspace 内に claude セッションが複数あり、送信先を一意に特定できません（誤送信防止のため中止）"
        err "popup から起動して origin ペインを渡すか、対象を1つに絞ってください"
        exit 1
      fi
      terminal_id=$(echo "$candidates" | jq -r '.terminal_id' | head -n1)
      if [ -n "$terminal_id" ]; then
        err "解決経路: 2 (agent list -> workspace 絞り込み)"
        printf '%s' "$terminal_id"
        return 0
      fi
    fi
  fi

  # 手順3: focused ワークスペースをフォールバック origin とみなす
  local ws_json focused_ws
  if ws_json=$(herdr workspace list 2>/dev/null); then
    focused_ws=$(echo "$ws_json" | jq -r '.result.workspaces[] | select(.focused==true) | .workspace_id' | head -n1)
    if [ -n "$focused_ws" ]; then
      local candidates count terminal_id
      candidates=$(echo "$agents" | jq -r --arg ws "$focused_ws" \
        '.result.agents[] | select(.agent=="claude" and .workspace_id==$ws)')
      count=$(echo "$candidates" | jq -s 'length')
      if [ "$count" -gt 0 ]; then
        if [ "$count" -gt 1 ]; then
          err "focused workspace 内に claude セッションが複数あり、送信先を一意に特定できません（誤送信防止のため中止）"
          err "popup から起動して origin ペインを渡すか、対象を1つに絞ってください"
          exit 1
        fi
        terminal_id=$(echo "$candidates" | jq -r '.terminal_id' | head -n1)
        if [ -n "$terminal_id" ]; then
          err "解決経路: 3 (focused workspace フォールバック)"
          printf '%s' "$terminal_id"
          return 0
        fi
      fi
    fi
  fi

  err "送信先の Claude セッションを解決できませんでした"
  exit 1
}

cmd_target() {
  echo "HERDR_ACTIVE_PANE_ID=${HERDR_ACTIVE_PANE_ID:-}"
  echo "HERDR_ACTIVE_WORKSPACE_ID=${HERDR_ACTIVE_WORKSPACE_ID:-}"
  echo "HERDR_WORKSPACE_ID=${HERDR_WORKSPACE_ID:-}"
  echo "prompts_file=$prompts_file"
  local terminal_id
  terminal_id=$(resolve_target)
  echo "resolved terminal_id=$terminal_id"
}

cmd_send() {
  require_cmd herdr
  local n="$1"
  local body terminal_id
  body=$(line_body "$n")
  terminal_id=$(resolve_target)
  if ! herdr agent send "$terminal_id" "$body"; then
    err "送信に失敗しました（送信先が存在しない/終了している可能性）: $terminal_id"
    exit 1
  fi
  err "注入しました（行 ${n}）: $terminal_id"
}

# ===== popup 用の対話 UI =====
# 選択行を readline で直す（エディタを開かない）
pick_edit_line() {
  local n="$1" old new
  old=$(line_body "$n")
  if ! has_tty; then
    err "端末がないため編集できません（行 ${n}）"
    return 1
  fi
  new=$(read_tty_edit "編集> " "$old")
  if [ -z "$new" ] || [ "$new" = "$old" ]; then
    err "編集は中止しました（行 ${n}）"
    return 1
  fi
  cmd_set "$n" "$new"
}

# 非対話の処理を走らせ、hp のメッセージ末尾行を見出し用に返す。
# fzf を開き直すと画面が流れてメッセージが読めないため、次の header に載せる。
step_msg() {
  local out=""
  out=$( ( "$@" ) 2>&1 ) || true
  printf '%s\n' "$out" | tail -n1
}

cmd_pick() {
  require_cmd fzf

  local keys="Enter:送信  C-n:追加  C-e:この行を編集  C-x:削除  C-o:エディタで全体編集"
  local query="" status_msg="" header out status key selected n

  # 追加・編集・削除の後は閉じずに一覧へ戻る（Enter の送信と ESC だけが終了）
  while :; do
    header="$keys"
    if [ -n "$status_msg" ]; then
      header="$keys
$status_msg"
    fi

    status=0
    out=$(entries | fzf \
      --delimiter='\t' \
      --with-nth=2.. \
      --print-query \
      --prompt="prompt> " \
      --query="$query" \
      --header="$header" \
      --preview='printf %s {2..}' \
      --preview-window=down,3,wrap \
      --expect=ctrl-n,ctrl-e,ctrl-x,ctrl-o) || status=$?

    # fzf の終了コード: 0=選択あり 1=一致なし 2=エラー 130=ESC/C-c などで中断。
    # 追加は「まだ無い文字を打ってから C-n」なので必ず 1 になる。中止扱いにしない。
    case "$status" in
      0|1) ;;
      130)
        err "中止しました"
        return 0
        ;;
      *)
        err "fzf が異常終了しました (exit=$status)"
        exit 1
        ;;
    esac

    # --print-query + --expect の出力は 1 行目=入力文字列、2 行目=押されたキー
    # （Enter なら空行）、3 行目=選択行（行番号<TAB>本文）
    query=$(printf '%s\n' "$out" | sed -n 1p)
    key=$(printf '%s\n' "$out" | sed -n 2p)
    selected=$(printf '%s\n' "$out" | sed -n 3p)
    n=$(printf '%s' "$selected" | cut -f1)

    case "$key" in
      ctrl-n)
        if [ -z "$query" ]; then
          status_msg="追加する本文を打ってから C-n を押してください"
          continue
        fi
        status_msg=$(step_msg cmd_add "$query")
        # 追加した行が一覧に見えるよう絞り込みを解除する
        query=""
        ;;
      ctrl-e)
        if [ -z "$n" ]; then
          status_msg="編集する行が選ばれていません"
          continue
        fi
        if ( pick_edit_line "$n" ); then
          status_msg="編集しました（行 ${n}）"
        else
          status_msg="編集しませんでした（行 ${n}）"
        fi
        ;;
      ctrl-x)
        if [ -z "$n" ]; then
          status_msg="削除する行が選ばれていません"
          continue
        fi
        if ( cmd_rm "$n" ); then
          status_msg="削除しました（行 ${n}）"
        else
          status_msg="削除しませんでした（行 ${n}）"
        fi
        ;;
      ctrl-o)
        if ( cmd_edit ); then
          status_msg="エディタで編集しました"
        else
          status_msg="エディタを開けませんでした"
        fi
        ;;
      *)
        if [ -z "$n" ]; then
          err "一致するプロンプトがありません: $query"
          err "この文字列を追加するなら C-n"
          exit 1
        fi
        cmd_send "$n"
        return 0
        ;;
    esac
  done
}

usage() {
  cat <<'EOF'
使い方（プロンプトは「1 行 = 1 プロンプト」のファイルに置く。指定は行番号）:
  hp [list]         行番号つきで一覧を表示
  hp show <n>       その行の本文を標準出力へ
  hp copy <n>       その行の本文をクリップボードへコピー
  hp add <text...>  1 行追加（エディタは開かない）
  hp set <n> <text> その行の本文を書き換える（エディタは開かない）
  hp edit           プロンプトファイル全体をエディタで開く
  hp rm <n>         その行を削除（確認あり）
  hp send <n>       その行を送信先 Claude セッションへリテラル注入（Enter なし）
  hp pick           fzf で選んで送信（popup 用。送信するまで閉じない）
                    C-n:追加  C-e:この行を編集  C-x:削除  C-o:エディタで全体編集
  hp target         送信先解決の診断（resolve_target の経路と結果を表示）

環境変数:
  HP_PROMPT_FILE    プロンプトファイル（既定: $XDG_STATE_HOME/hp/prompts.txt）
  HP_EDITOR         エディタ（既定: VISUAL > EDITOR > nvim）
  HP_LOG            メッセージの控えを追記するログファイル（popup 用）
EOF
}

main() {
  local sub="${1:-list}"
  [ $# -gt 0 ] && shift || true

  case "$sub" in
    list)
      cmd_list
      ;;
    show)
      [ $# -ge 1 ] || { err "使い方: hp show <n>"; exit 1; }
      cmd_show "$1"
      ;;
    copy)
      [ $# -ge 1 ] || { err "使い方: hp copy <n>"; exit 1; }
      cmd_copy "$1"
      ;;
    add|new)
      [ $# -ge 1 ] || { err "使い方: hp add <text...>"; exit 1; }
      cmd_add "$@"
      ;;
    set)
      [ $# -ge 2 ] || { err "使い方: hp set <n> <text...>"; exit 1; }
      cmd_set "$@"
      ;;
    edit)
      cmd_edit
      ;;
    rm|remove|delete)
      [ $# -ge 1 ] || { err "使い方: hp rm <n>"; exit 1; }
      cmd_rm "$1"
      ;;
    send)
      [ $# -ge 1 ] || { err "使い方: hp send <n>"; exit 1; }
      cmd_send "$1"
      ;;
    pick)
      cmd_pick
      ;;
    target)
      cmd_target
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      err "不明なサブコマンド: $sub"
      usage
      exit 1
      ;;
  esac
}

main "$@"

command = /bin/zsh -l -c herdr

window-padding-x = 12
window-padding-y = 8
window-decoration = false

cursor-style-blink = false
mouse-hide-while-typing = true


background-blur = false
background-opacity = 1
background-blur-radius = 0

scrollback-limit = 5000000

shell-integration-features = no-cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path

font-family = HackGen Console NF
font-family-bold = HackGen Console NF
font-family-italic = HackGen Console NF
font-family-bold-italic = HackGen Console NF
font-size = 18

keybind = clear
keybind = super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard
keybind = super+,=open_config

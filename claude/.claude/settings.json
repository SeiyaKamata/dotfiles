{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git show *)",
      "Bash(git tag *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cd *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(make *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go run *)",
      "Bash(go generate *)",
      "Bash(go mod *)",
      "Bash(go vet *)",
      "Bash(go fmt *)",
      "Bash(go tool *)",
      "Read(~/Develop/*)"
    ],
    "deny": [
      "AskUserQuestion",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(git worktree *)",
      "Bash(git * worktree *)",
      "Bash(herdr worktree *)",
      "Bash(herdr * worktree *)",
      "EnterWorktree",
      "ExitWorktree"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/skills/_report/render.py --hook"
          }
        ]
      }
    ]
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "serena@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "yellow@lrm-equipment": true,
    "recipient-centric@lrm-equipment": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "language": "Japanese",
  "promptSuggestionEnabled": false,
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "yellow@lrm-equipment": {
      "options": {
        "work_root": "/Users/kamata_seiya/Develop/_work"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "showTurnDuration": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults"
    ],
    "soft_deny": [
      "$defaults",
      "Out-of-Repo Write: writing to any path outside the working repo requires the user to name the destination path."
    ],
    "environment": [
      "$defaults",
      "Trusted repo: exactly two locations on disk are mine — the personal dotfiles repo at ~/Develop/kamata/repos/dotfiles, and my employer's repos under ~/Develop/lrm-corp/repos/. All are private. The tilde form and the $HOME form of these prefixes are equivalent; the machine may be macOS or Linux, so no OS-specific absolute form (e.g. /Users/... or /home/...) is assumed.",
      "Trusted remotes: git@github.com:SeiyaKamata/dotfiles.git and github.com/lrm-corp/* (all private). Any other remote URL is outside the boundary, including a remote added or repointed during the session.",
      "These two locations REPLACE the default working-directory trust: if the session's working directory is not under one of them, the working repo is NOT a trusted repo, and commits and pushes there are judged as landing outside the boundary. Anything cloned under ~/Develop merely to read it is therefore untrusted; a repo is never mine because of where it sits on disk."
    ]
  },
  "mcpServers": {
    "shogun": {
      "disabled": false
    }
  },
  "startupTipsEnabled": false
}

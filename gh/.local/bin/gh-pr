#!/usr/bin/env bash
# lrm-corp 配下の PR を gh でチェックし、標準出力 + macOS 通知するツール。
#
#   gh-pr review   自分がレビュアーに指定された open PR を一覧し、
#                  レビューに入る `gh pr checkout <url>` を出力する。
#   gh-pr mine     自分が作った open PR のレビュー状況と、PR への未読の
#                  返信・メンションを一覧し、approve 済みなら merge コマンドを出力する。
#   gh-pr ci [PR]        1 本の PR のチェックを監視する。完了したら終了。
#   gh-pr comments [PR]  1 本の PR のレビュー判定・コメント・未解決スレッドを監視する。
#                        どちらも PR 省略時は現在のブランチの PR。
#
# 共通オプション:
#   -w            watch モード（一定間隔で繰り返し実行）
#   -i SECONDS    watch の間隔（デフォルト 300 秒）
#   -o ORG        対象 org（デフォルト lrm-corp）
#   -h            ヘルプ
#
# 使用例:
#   gh-pr review           # 1 回だけチェック
#   gh-pr review -w        # watch（300 秒間隔）
#   gh-pr mine -w -i 120   # 自分の PR を 120 秒間隔で watch
#
# 前提: gh にログイン済み（gh auth status で確認）。
# 通知は herdr があれば herdr notification（リモート越しでも手元に届く）、
# 無ければ macOS の osascript、Linux の notify-send の順にフォールバックする。
set -euo pipefail

# --- 設定 ---
ORG="lrm-corp"
INTERVAL=300
WATCH=0
TARGET=""
LAST_SIG=""
DONE=0
# approve 済み PR に出力する merge コマンド。repo の設定に合わせて調整可
# （例: --merge / --rebase）。
MERGE_CMD="gh pr merge %s --squash --delete-branch"

usage() {
  cat <<EOF
Usage: ${0##*/} <review|mine> [-w] [-i SECONDS] [-o ORG]
       ${0##*/} <ci|comments> [PR番号|URL|ブランチ] [-w] [-i SECONDS]

Commands:
  ci       1 本の PR のチェック結果を表示。引数省略で現在のブランチの PR。
           -w では状態が変わるたびに通知し、チェックが完了したら終了
  comments 1 本の PR のレビュー判定・コメント数・未解決スレッドを表示。引数省略で現在のブランチの PR。
           -w では状態が変わるたびに通知し、PR が open でなくなったら終了
  review   自分がレビュアーに指定された open PR を一覧 + \`gh pr checkout\` を出力
  mine     自分の open PR のレビュー状況と未読の返信・メンションを一覧、approve 済みは merge コマンドを出力

Options:
  -w            watch モード（一定間隔で繰り返し実行）
  -i SECONDS    watch の間隔（デフォルト ${INTERVAL} 秒）
  -o ORG        対象 org（デフォルト ${ORG}）
  -h            このヘルプ
EOF
}

# 通知。herdr があれば herdr notification（herdr サーバー経由でアタッチ中の
# クライアントに出るため、リモートで watch させても手元に届く）。無ければ
# macOS の osascript、Linux の notify-send の順にフォールバック。
# いずれも通知不可でも本体は継続。
notify() {
  local title="$1" msg="$2"
  # herdr は通知が無効 (delivery=off) でも exit 0 で {"shown":false} を返すため、
  # exit code ではなく shown:true を確認してから成功扱いにする。
  if command -v herdr >/dev/null 2>&1; then
    local res
    res=$(herdr notification show "$title" --body "$msg" 2>/dev/null) || res=""
    case "$res" in
      *'"shown":true'*) return ;;
    esac
  fi
  if command -v osascript >/dev/null 2>&1; then
    title=${title//\\/\\\\}; title=${title//\"/\\\"}
    msg=${msg//\\/\\\\}; msg=${msg//\"/\\\"}
    osascript -e "display notification \"$msg\" with title \"$title\"" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "$title" "$msg" >/dev/null 2>&1 || true
  fi
}

# --- review: 自分がレビュアーに指定された open PR ---
cmd_review() {
  # 取得する PR フィールド（この直後の gh search prs で使う）
  local fields="number,title,url,repository,author,isDraft"

  local out
  out=$(gh search prs --owner "$ORG" --review-requested=@me --state open \
    --json "$fields" \
    --jq '.[] | select(.isDraft | not)
          | [.repository.nameWithOwner, (.number|tostring), .author.login, .url, .title] | @tsv' \
    2>/dev/null) || {
      echo "gh search に失敗しました（gh auth status を確認してください）" >&2
      return 1
    }

  if [ -z "$out" ]; then
    echo "レビュー依頼された open PR はありません（org: $ORG）"
    return 0
  fi

  local count=0
  echo "=== レビュー依頼された open PR (org: $ORG) ==="
  echo
  while IFS=$'\t' read -r repo number author url title; do
    count=$((count + 1))
    printf '● %s  #%s  by @%s\n' "$repo" "$number" "$author"
    printf '  %s\n' "$title"
    printf '  %s\n' "$url"
    printf '  gh pr checkout %s\n\n' "$url"
  done <<< "$out"

  notify "レビュー依頼 (${ORG})" "${count} 件のレビュー待ち PR があります"
}

# --- mine: 自分が作った open PR のレビュー状況 ---
cmd_mine() {
  # 自分の PR を検索して URL だけ取り、詳細は後段で 1 件ずつ引く
  local search_fields="url"
  # 各 PR のレビュー状況を取得するフィールド
  local view_fields="title,reviewDecision,reviews"

  local urls
  urls=$(gh search prs --owner "$ORG" --author=@me --state open \
    --json "$search_fields" --jq '.[].url' 2>/dev/null) || {
      echo "gh search に失敗しました（gh auth status を確認してください）" >&2
      return 1
    }

  if [ -z "$urls" ]; then
    echo "自分の open PR はありません（org: $ORG）"
    return 0
  fi

  local reviewed_count=0 approved_count=0
  echo "=== 自分の open PR のレビュー状況 (org: $ORG) ==="
  echo

  while IFS= read -r url; do
    [ -z "$url" ] && continue

    # reviewDecision / 着いたレビュー state / タイトルを 1 行ずつ取得する。
    # （タブ区切りだと bash の read がタブを空白扱いして空フィールドを畳み込み、
    #   reviewDecision が空の PR で列がずれるため、改行区切りで個別に読む）
    # 末尾の `|| true`: gh pr view 失敗で出力が空だと read が EOF で非 0 を返し、
    #   set -e でスクリプト全体が落ちるのを防ぐ（この PR だけスキップさせる）。
    local decision="" states="" title=""
    {
      IFS= read -r decision
      IFS= read -r states
      IFS= read -r title
    } < <(gh pr view "$url" --json "$view_fields" --jq '
      (.reviewDecision // "" | if . == "" then "NONE" else . end),
      ([.reviews[].state] | unique | join(",")),
      .title' 2>/dev/null) || true

    # レビューが何も着いていない PR（や取得失敗）はスキップ。
    [ -z "$states" ] && continue

    reviewed_count=$((reviewed_count + 1))
    printf '● %s\n' "$title"
    printf '  %s\n' "$url"
    printf '  レビュー: %s / 判定: %s\n' "$states" "$decision"

    # マージ可否: reviewDecision が APPROVED、または（レビュー必須でない repo で）
    # 承認が着いていて変更要求が無い場合。
    local approvable=0
    if [ "$decision" = "APPROVED" ]; then
      approvable=1
    elif [ "$decision" = "NONE" ] \
      && [[ ",$states," == *",APPROVED,"* ]] \
      && [[ ",$states," != *",CHANGES_REQUESTED,"* ]]; then
      approvable=1
    fi

    if [ "$approvable" -eq 1 ]; then
      approved_count=$((approved_count + 1))
      printf '  ✅ approve 済み → マージ可能:\n'
      # shellcheck disable=SC2059
      printf "  ${MERGE_CMD}\n" "$url"
    fi
    echo
  done <<< "$urls"

  [ "$reviewed_count" -eq 0 ] && echo "レビューが着いた PR はまだありません（org: $ORG）"

  # 未読通知のうち、自分が立てた PR への新着 (reason=author) と被メンション。
  # notifications API は unread のみ返す。subject.url (API 形式) から html_url を組む。
  local replies
  replies=$(gh api notifications --paginate 2>/dev/null \
    | jq -r --arg org "$ORG" '
        .[]
        | select(.subject.type == "PullRequest")
        | select(.reason == "author" or .reason == "mention")
        | select(.repository.full_name | startswith($org + "/"))
        | (.subject.url | capture("repos/(?<r>[^/]+/[^/]+)/pulls/(?<n>[0-9]+)")) as $m
        | [$m.r, $m.n, .reason, .subject.title] | @tsv' 2>/dev/null) || replies=""

  local reply_count=0
  if [ -n "$replies" ]; then
    echo
    echo "=== 自分の PR への返信・メンション (未読, org: $ORG) ==="
    echo
    while IFS=$'\t' read -r repo number reason title; do
      [ -z "$repo" ] && continue
      reply_count=$((reply_count + 1))
      printf '● %s  #%s  [%s]\n' "$repo" "$number" "$reason"
      printf '  %s\n' "$title"
      printf '  https://github.com/%s/pull/%s\n\n' "$repo" "$number"
    done <<< "$replies"
  fi

  local msg=""
  [ "$reviewed_count" -gt 0 ] && msg="レビューが着いた PR: ${reviewed_count} 件"
  [ "$approved_count" -gt 0 ] && msg="${msg:+$msg / }approve 済み: ${approved_count} 件（マージ可）"
  [ "$reply_count" -gt 0 ] && msg="${msg:+$msg / }返信・メンション: ${reply_count} 件"
  [ -n "$msg" ] && notify "自分の PR (${ORG})" "$msg"
}

# --- ci / comments 共通 ---
view_pr() {
  local out
  out=$(gh pr view ${TARGET:+"$TARGET"} --json "$1" 2>&1) || {
    echo "PR が見つかりません。ブランチが push 済みで PR が作成済みか確認してください" >&2
    echo "$out" >&2
    return 1
  }
  printf '%s\n' "$out"
}

notify_on_change() {
  local sig="$1" title="$2" msg="$3"
  if [ -n "$LAST_SIG" ] && [ "$sig" != "$LAST_SIG" ]; then
    notify "$title" "$msg"
  fi
  LAST_SIG="$sig"
}

# --- ci: 1 本の PR のチェックを監視 ---
cmd_ci() {
  local json
  json=$(view_pr number,title,url,state,statusCheckRollup) || return 1

  local number title url state
  number=$(jq -r '.number' <<< "$json")
  title=$(jq -r '.title' <<< "$json")
  url=$(jq -r '.url' <<< "$json")
  state=$(jq -r '.state' <<< "$json")

  local checks
  checks=$(jq -r '.statusCheckRollup[]?
    | [(.name // .context),
       (if (.conclusion // "") != "" then .conclusion
        elif (.state // "") != "" then .state
        else .status end)] | @tsv' <<< "$json")

  local failed=0 pending=0 total=0 name result
  while IFS=$'\t' read -r name result; do
    [ -z "$name" ] && continue
    total=$((total + 1))
    case "$result" in
      SUCCESS|NEUTRAL|SKIPPED) ;;
      FAILURE|CANCELLED|TIMED_OUT|ACTION_REQUIRED|ERROR) failed=$((failed + 1)) ;;
      *) pending=$((pending + 1)) ;;
    esac
  done <<< "$checks"

  local ci="none"
  if [ "$total" -gt 0 ]; then
    if [ "$pending" -gt 0 ]; then ci="pending"
    elif [ "$failed" -gt 0 ]; then ci="failed"
    else ci="passed"
    fi
  fi

  printf '● %s  #%s  [%s]\n' "$title" "$number" "$state"
  printf '  %s\n' "$url"
  printf '  CI: %s（失敗 %s / 実行中 %s / 全 %s）\n' "$ci" "$failed" "$pending" "$total"
  if [ "$failed" -gt 0 ]; then
    echo "  失敗したチェック:"
    while IFS=$'\t' read -r name result; do
      case "$result" in
        FAILURE|CANCELLED|TIMED_OUT|ACTION_REQUIRED|ERROR) printf '    - %s: %s\n' "$name" "$result" ;;
      esac
    done <<< "$checks"
  fi

  notify_on_change "$state|$ci|$failed" "PR #${number} CI" "CI=${ci} 失敗=${failed} 実行中=${pending}"

  case "$ci" in passed|failed) DONE=1 ;; esac
  [ "$state" != "OPEN" ] && DONE=1
  return 0
}

# --- comments: 1 本の PR のレビュー判定・コメント・未解決スレッドを監視 ---
cmd_comments() {
  local json
  json=$(view_pr number,title,url,state,reviewDecision,comments,reviews) || return 1

  local number title url state decision comment_count review_count
  number=$(jq -r '.number' <<< "$json")
  title=$(jq -r '.title' <<< "$json")
  url=$(jq -r '.url' <<< "$json")
  state=$(jq -r '.state' <<< "$json")
  decision=$(jq -r '.reviewDecision // "NONE" | if . == "" then "NONE" else . end' <<< "$json")
  comment_count=$(jq -r '.comments | length' <<< "$json")
  review_count=$(jq -r '.reviews | length' <<< "$json")

  local path owner repo threads unresolved="?" thread_comments="?"
  path=${url#https://github.com/}
  owner=${path%%/*}
  repo=${path#*/}; repo=${repo%%/*}
  threads=$(gh api graphql \
    -f query='query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){pullRequest(number:$n){reviewThreads(first:100){nodes{isResolved comments{totalCount}}}}}}' \
    -f o="$owner" -f r="$repo" -F n="$number" \
    --jq '.data.repository.pullRequest.reviewThreads.nodes
          | "\([.[] | select(.isResolved | not)] | length) \([.[].comments.totalCount] | add // 0)"' \
    2>/dev/null) || threads=""
  [ -n "$threads" ] && read -r unresolved thread_comments <<< "$threads"

  printf '● %s  #%s  [%s]\n' "$title" "$number" "$state"
  printf '  %s\n' "$url"
  printf '  レビュー判定: %s / 未解決スレッド: %s\n' "$decision" "$unresolved"
  printf '  コメント: %s / レビュー: %s / スレッド内コメント: %s\n' "$comment_count" "$review_count" "$thread_comments"
  if [ "$state" = "OPEN" ] && [ "$decision" = "APPROVED" ]; then
    echo "  ✅ approve 済み → マージ可能:"
    # shellcheck disable=SC2059
    printf "  ${MERGE_CMD}\n" "$url"
  fi

  notify_on_change "$state|$decision|$unresolved|$comment_count|$review_count|$thread_comments" \
    "PR #${number} コメント" "レビュー=${decision} 未解決=${unresolved} コメント=${comment_count} レビュー数=${review_count}"

  [ "$state" != "OPEN" ] && DONE=1
  return 0
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    review|mine) shift ;;
    ci|comments)
      shift
      if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
        TARGET="$1"
        shift
      fi
      ;;
    -h|--help|"") usage; exit 0 ;;
    *) echo "不明なコマンド: $cmd" >&2; usage; exit 1 ;;
  esac

  while getopts "wi:o:h" opt; do
    case "$opt" in
      w) WATCH=1 ;;
      i) INTERVAL="$OPTARG" ;;
      o) ORG="$OPTARG" ;;
      h) usage; exit 0 ;;
      *) usage; exit 1 ;;
    esac
  done

  local runner="cmd_${cmd}"
  if [ "$WATCH" -eq 1 ]; then
    while true; do
      clear
      date '+%Y-%m-%d %H:%M:%S'
      echo
      "$runner" || true
      if [ "$DONE" -eq 1 ]; then
        echo "PR が open ではなくなったため watch を終了します"
        break
      fi
      sleep "$INTERVAL"
    done
  else
    "$runner"
  fi
}

main "$@"

#!/usr/bin/env python3
"""herdr の space を「開く場所を先に選んでから」作る fzf ピッカー。

space を作ってから cd するのをやめ、プロジェクトを選んだ時点でその cwd の
space が立ち上がるようにする。config.toml の prefix+n（popup）から呼ぶ。

候補: <root>/repos/<repo> と <root>/worktrees/<SLOT>/<repo>（root は ~/Develop/*）。
      git 管理外でも作業対象になりうるのでディレクトリなら拾い、作業場所に
      ならない名前（IGNORE）だけを除く。
並び: zoxide の frecency 順。未訪問は末尾に名前順で並ぶ（一覧からは消さない）。
表示: 略称・パス・すでに space が開いているかの印（●）。
      略称表は <root>/.project-aliases.toml が唯一の source（alias.py と同じ）。

使い方:
  hspace          … fzf で選んで space を作る
  hspace --list   … 候補一覧を表示するだけ（動作確認用）
"""
import json
import os
import re
import subprocess
import sys
import tomllib

HERDR = os.environ.get("HERDR_BIN_PATH") or "herdr"
DEV_ROOT = os.path.expanduser("~/Develop")
ALIAS_FILE = ".project-aliases.toml"
# repos 直下に混ざる作業場所ではないディレクトリ
IGNORE = {"__pycache__", "tmp", "node_modules"}


def sh(args, **kw):
    return subprocess.run(args, capture_output=True, text=True, **kw)


def load_aliases(root):
    """<root>/.project-aliases.toml の [aliases] を ディレクトリ名 -> 略称 に変換。"""
    try:
        with open(os.path.join(root, ALIAS_FILE), "rb") as f:
            data = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    mapping = {}
    for alias, projects in (data.get("aliases") or {}).items():
        if isinstance(projects, str):
            projects = [projects]
        for proj in projects:
            if proj:
                mapping[proj] = alias.upper()
    return mapping


def candidates():
    """(path, label) のリストを返す。"""
    out = []
    for root in sorted(_subdirs(DEV_ROOT)):
        aliases = load_aliases(root)

        def label_of(repo, slot=None):
            base = aliases.get(repo, repo)
            return f"{base}({slot})" if slot else base

        for repo in sorted(_subdirs(os.path.join(root, "repos"))):
            out.append((repo, label_of(os.path.basename(repo))))
        for slot in sorted(_subdirs(os.path.join(root, "worktrees"))):
            for repo in sorted(_subdirs(slot)):
                out.append(
                    (repo, label_of(os.path.basename(repo), os.path.basename(slot)))
                )
    return out


def _subdirs(path):
    try:
        entries = os.scandir(path)
    except OSError:
        return []
    return [
        e.path
        for e in entries
        if e.is_dir() and not e.name.startswith(".") and e.name not in IGNORE
    ]


def zoxide_rank():
    """パス -> frecency 順の順位。zoxide が無ければ空。"""
    r = sh(["zoxide", "query", "-l"])
    if r.returncode != 0:
        return {}
    return {p: i for i, p in enumerate(r.stdout.splitlines()) if p}


def open_dirs():
    """今 space が開いている cwd の集合。"""
    r = sh([HERDR, "api", "snapshot"])
    if r.returncode != 0:
        return set()
    try:
        snap = json.loads(r.stdout)["result"]["snapshot"]
    except (ValueError, KeyError):
        return set()
    dirs = set()
    for coll in ("agents", "panes"):
        for p in snap.get(coll, []):
            c = p.get("foreground_cwd") or p.get("cwd")
            if c:
                dirs.add(c)
    return dirs


def tilde(path):
    home = os.path.expanduser("~")
    return re.sub(r"^" + re.escape(home), "~", path)


def build_lines():
    rank = zoxide_rank()
    opened = open_dirs()
    items = candidates()
    items.sort(key=lambda x: (rank.get(x[0], len(rank) + 1), x[1]))

    # 1 行の構成: 表示用テキスト \t パス \t ラベル（fzf には第 1 列だけ見せる）
    width = max((len(label) for _, label in items), default=0)
    lines = []
    for path, label in items:
        mark = "●" if any(c == path or c.startswith(path + "/") for c in opened) else " "
        lines.append(f"{mark} {label:<{width}}  {tilde(path)}\t{path}\t{label}")
    return lines


def main():
    lines = build_lines()
    if not lines:
        print("hspace: 候補が見つかりません", file=sys.stderr)
        return 1

    if "--list" in sys.argv[1:]:
        for line in lines:
            print(line.split("\t")[0])
        return 0

    fzf = subprocess.run(
        [
            "fzf",
            "--prompt=space> ",
            "--height=100%",
            "--reverse",
            "--delimiter=\t",
            "--with-nth=1",
            "--header=Enter:その場所で space を作る  ●:すでに space が開いている",
        ],
        input="\n".join(lines),
        capture_output=True,
        text=True,
    )
    if fzf.returncode != 0 or not fzf.stdout.strip():
        return 0  # ESC / 中止

    _, path, label = fzf.stdout.strip().split("\n")[0].split("\t")

    r = sh([HERDR, "workspace", "create", "--cwd", path, "--label", label, "--focus"])
    if r.returncode != 0:
        print(r.stderr or r.stdout, file=sys.stderr)
        return r.returncode
    return 0


if __name__ == "__main__":
    sys.exit(main())

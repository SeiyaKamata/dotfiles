#!/bin/bash
# bare化した repos/<name> から新規 worktree を作成する。
# repos/<name> と同じ階層の worktrees/ 配下に worktree を作る前提
# （Develop/<org>/repos, Develop/<org>/worktrees の対応）。
# 対話プロンプトは持たない。devpick からも Claude からも同じ引数で呼べるようにするため。
# 常に origin の最新デフォルトブランチの先端に detached HEAD で作る。
# ブランチは実装を始める skill が切るので、ここでは作らない。
# name省略時は <repo名>-<YYYYMMDDHHMMSS> を機械的に生成する。衝突したら連番を足す。
set -euo pipefail

repo="${1:?usage: mkworktree <bare-repo-path> [name]}"
name="${2:-}"

[ -d "$repo" ] || { echo "見つかりません: $repo" >&2; exit 1; }
git -C "$repo" rev-parse --is-bare-repository 2>/dev/null | grep -qx true \
  || { echo "bare repoではありません: $repo" >&2; exit 1; }

worktrees_root="$(dirname "$(dirname "$repo")")/worktrees"
mkdir -p "$worktrees_root"

if [ -z "$name" ]; then
  base="$(basename "$repo")-$(date +%Y%m%d%H%M%S)"
  name="$base"
  suffix=2
  while [ -e "$worktrees_root/$name" ]; do
    name="${base}-${suffix}"
    suffix=$((suffix + 1))
  done
fi

dest="$worktrees_root/$name"
[ -e "$dest" ] && { echo "既に存在します: $dest" >&2; exit 1; }

# bare repoはリモートのブランチがそのまま refs/heads/* に入り、refs/remotes/origin/* は持たない。
default_branch=$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null)
if [ -z "$default_branch" ]; then
  for cand in main master; do
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$cand"; then
      default_branch="$cand"
      break
    fi
  done
fi
[ -n "$default_branch" ] || { echo "デフォルトブランチを判定できません: $repo" >&2; exit 1; }

# 対象ブランチだけを更新する。全ブランチを対象にすると、他のworktreeでcheckout中のブランチがある場合に失敗するため。
git -C "$repo" fetch origin "+refs/heads/$default_branch:refs/heads/$default_branch" >&2

git -C "$repo" worktree add --detach "$dest" "$default_branch" >&2

# .specs は ~/Develop/.specs に 1 つだけ置き、全リポジトリ・全 worktree で共有する。
#   複数リポジトリにまたがる feature や epic が 1 箇所に置けるようにするため。
# CLAUDE.local.md はリポジトリ固有なので、bare repo自身のものを張る。
specs_home="$HOME/Develop"

link() {
  local src="$1" name="$2"
  [ -e "$dest/$name" ] && return 0
  [ -e "$src" ] || return 0
  local link_dir
  link_dir="$dest/$(dirname "$name")"
  mkdir -p "$link_dir"
  local target
  target=$(python3 -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$src" "$link_dir")
  ln -s "$target" "$dest/$name"
}

init() {
  local src="$1" content="$2"
  [ -e "$src" ] && return 0
  mkdir -p "$(dirname "$src")"
  printf '%s' "$content" > "$src"
}

init "$repo/CLAUDE.local.md" ""
init "$repo/.claude/settings.local.json" '{}
'

link "$specs_home/.specs" .specs
link "$repo/CLAUDE.local.md" CLAUDE.local.md
link "$repo/.claude/settings.local.json" .claude/settings.local.json

printf '%s\n' "$dest"

#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/gh-watch"
mkdir -p "$state_dir"

notify() {
  herdr notification show "$1" --body "$2" >/dev/null 2>&1 || true
}

# 関心1: 自分がレビュアー指定されている open PR
review_seen="$state_dir/review-seen.json"
[ -f "$review_seen" ] || echo '[]' >"$review_seen"

review_now="$(gh search prs --review-requested=@me --state=open --limit 50 \
  --json number,title,repository 2>/dev/null || true)"
[ -n "$review_now" ] || review_now='[]'

review_new="$(jq -n --argjson cur "$review_now" --slurpfile s "$review_seen" '
  ($s[0] // []) as $seen
  | [ $cur[]
      | (.repository.nameWithOwner + "#" + (.number | tostring)) as $key
      | select($seen | index($key) | not) ]
')"

if [ "$(jq 'length' <<<"$review_new")" -gt 0 ]; then
  body="$(jq -r '.[] | "\(.repository.nameWithOwner) #\(.number)  \(.title)"' <<<"$review_new" | head -5)"
  notify "👀 レビュー依頼 $(jq 'length' <<<"$review_new")件" "$body"
fi

jq '[ .[] | .repository.nameWithOwner + "#" + (.number | tostring) ]' <<<"$review_now" >"$review_seen.tmp"
mv "$review_seen.tmp" "$review_seen"

# 関心2: 自分の PR への返信・メンション
reply_seen="$state_dir/reply-seen.json"
[ -f "$reply_seen" ] || echo '[]' >"$reply_seen"

notif_now="$(gh api notifications --paginate 2>/dev/null || true)"
[ -n "$notif_now" ] || notif_now='[]'

reply_now="$(jq -s '
  [ .[][]
    | select(.subject.type == "PullRequest")
    | select(.reason == "author" or .reason == "comment" or .reason == "mention")
    | { key: (.id + "@" + .updated_at),
        repo: .repository.full_name,
        num: (.subject.url | split("/") | last),
        title: .subject.title } ]
' <<<"$notif_now")"

reply_new="$(jq -n --argjson cur "$reply_now" --slurpfile s "$reply_seen" '
  ($s[0] // []) as $seen
  | [ $cur[] | . as $n | select($seen | index($n.key) | not) ]
')"

if [ "$(jq 'length' <<<"$reply_new")" -gt 0 ]; then
  body="$(jq -r '.[] | "\(.repo) #\(.num)  \(.title)"' <<<"$reply_new" | head -5)"
  notify "💬 PR返信 $(jq 'length' <<<"$reply_new")件" "$body"
fi

jq '[ .[].key ]' <<<"$reply_now" >"$reply_seen.tmp"
mv "$reply_seen.tmp" "$reply_seen"

#!/bin/bash
# 1 文字のキーで待ち状態を選んで stage に渡す。herdr の popup から呼ぶ。
set -euo pipefail

# popup には呼び出し元の space と pane が HERDR_ACTIVE_ 付きの変数で渡り、stage が読む名前では来ない。
export HERDR_WORKSPACE_ID="${HERDR_ACTIVE_WORKSPACE_ID:-}"
export HERDR_PANE_ID="${HERDR_ACTIVE_PANE_ID:-}"

chip=$'\033[1;38;2;0;0;0;48;2;250;179;135m'
dim=$'\033[48;2;38;38;38m'
off=$'\033[0m'

row() {
  local mark
  mark=$(stage "$2" --print)
  printf '  %s %s %s\033[8G\033[38;2;243;139;168m%s%s\033[14G%s\n' "$chip" "$1" "$off" "$mark" "$off" "$3"
}

row s selfreview セルフレビュー待ち
row r review レビュー待ち
row q qa 'QA 待ち'
row d complete 完了
row p pause 一時停止
row l low 優先度を下げる
row n misc タスクではない
row c clear 表示を消す
printf '\n  %s esc cancel %s' "$dim" "$off"

read -rsn1 key
case "$key" in
  n) stage misc ;;
  l) stage low ;;
  p) stage pause ;;
  d) stage complete ;;
  q) stage qa ;;
  s) stage selfreview ;;
  r) stage review ;;
  c) stage clear ;;
esac

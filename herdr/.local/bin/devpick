#!/bin/bash

# repos 配下は必ず bare repo。git を呼ばずパスだけで判定できるので、
# repos 側と worktrees 側を find の時点で分けて、bare repo への git 呼び出しを避ける。
sel=$( { command find "$HOME"/Develop/*/repos -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null \
           | while IFS= read -r path; do printf '%s\t%s\t%s\n' "${path##*/}" '(bare)' "$path"; done
         command find "$HOME"/Develop/*/worktrees -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null \
           | while IFS= read -r path; do
               branch=$(git -C "$path" branch --show-current 2>/dev/null)
               printf '%s\t%s\t%s\n' "${path##*/}" "${branch:--}" "$path"
             done
       } \
  | sort \
  | awk -F'\t' '{ name[NR]=$1; branch[NR]=$2; path[NR]=$3; if (length($1) > w) w = length($1) }
                END { for (i = 1; i <= NR; i++) printf "%-" w "s\t%s\t%s\n", name[i], branch[i], path[i] }' \
  | fzf --prompt="space> " --delimiter='\t' --with-nth=1,2 --nth=1)
# 末尾フィールド(絶対パス)だけを取り出す。branch 名にタブは含まれないので
# 最後のタブより後ろを取れば安全に path が取れる。
[ -n "$sel" ] || exit 0
path="${sel##*$'\t'}"

# repos 配下は bare repo。そのままでは作業できないので、名前を聞いて
# mkworktree に渡し、worktrees 配下へ新規 worktree を作らせてその path を採用する。
case "$path" in
  "$HOME"/Develop/*/repos/*)
    printf 'worktree名（空なら機械的命名）> ' >&2
    read -r name
    if [ -n "$name" ]; then
      path=$("$(dirname "$0")/mkworktree" "$path" "$name") || exit 1
    else
      path=$("$(dirname "$0")/mkworktree" "$path") || exit 1
    fi
    ;;
esac

[ -n "$path" ] && printf '%s\n' "$path"

#!/bin/bash

# fzf の reload から呼ばれる。{} を含むコマンドは fzf が置換してしまうため、リスト生成はここに閉じる。
list_features() {
  local q="${1:-}"
  if [ -z "$q" ]; then printf 'new\t新規作成\n'; else printf 'new\t「%s」で新規作成\n' "$q"; fi
  command find "$HOME"/Develop/.specs -mindepth 1 -maxdepth 1 -type d ! -name '.*' -exec basename {} \; | sort \
    | awk 'NR==FNR { linked[$0]; next } !($0 in linked)' <(linked_features) - \
    | sed 's/^/feat\t/'
}

# worktree の .specs symlink が指す feature は紐づき済みなので、選択肢から外すために集める。
linked_features() {
  command find "$HOME"/Develop/*/worktrees -mindepth 2 -maxdepth 2 -name .specs -type l -exec readlink {} \; 2>/dev/null \
    | sed 's|.*/||'
}

# repos 側と worktrees 側を find の時点で分けて、bare repo への git 呼び出しを避ける。
# repos 配下で .git を持つものは dotfiles のように作業ツリーそのものを使う repo。
list_spaces() {
  local path kind branch org
  for path in "$HOME"/Develop/*/repos; do
    [ -d "$path" ] || continue
    org="${path%/repos}"
    printf '%s/repos\t%s\t%s\n' "${org##*/}" '(dir)' "$path"
  done
  command find "$HOME"/Develop/*/repos -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null \
    | while IFS= read -r path; do
        if is_main_repo "$path"; then kind='(main)'; else kind='(bare)'; fi
        printf '%s\t%s\t%s\n' "${path##*/}" "$kind" "$path"
      done
  command find "$HOME"/Develop/*/worktrees -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null \
    | while IFS= read -r path; do
        branch=$(git -C "$path" branch --show-current 2>/dev/null)
        printf '%s\t%s\t%s\n' "${path##*/}" "${branch:--}" "$path"
      done
}

is_main_repo() {
  [ -e "$1/.git" ]
}

pick_space() {
  local sel
  sel=$(list_spaces \
    | sort \
    | awk -F'\t' '{ name[NR]=$1; branch[NR]=$2; path[NR]=$3; if (length($1) > w) w = length($1) }
                  END { for (i = 1; i <= NR; i++) printf "%-" w "s\t%s\t%s\n", name[i], branch[i], path[i] }' \
    | fzf --prompt="space> " --delimiter='\t' --with-nth=1,2 --nth=1)
  [ -n "$sel" ] || return 1
  printf '%s\n' "${sel##*$'\t'}"
}

# 選んだ feature 名を出力する。新規作成なら .specs 配下にディレクトリも作る。何も選ばなければ空を出力する。
# 戻り値は、中断が 1、入力不正が 2。
pick_feature() {
  local out query sel feature=""
  out=$(list_features "" \
    | fzf --prompt="feature> " --no-sort --print-query --delimiter='\t' --with-nth=2 \
        --bind "change:reload:'$0' --list {q}") || return 1
  { IFS= read -r query; IFS= read -r sel; } <<<"$out"
  if [ "${sel%%$'\t'*}" = feat ]; then
    feature="${sel#*$'\t'}"
  elif [ -n "$query" ]; then
    case "$query" in */*) echo "feature 名に / は使えません: $query" >&2; return 2 ;; esac
    feature="$query"
    mkdir -p "$HOME/Develop/.specs/$feature"
  fi
  printf '%s\n' "$feature"
}

# bare repo はそのままでは作業できないので mkworktree に渡し、新規 worktree を作らせてその path を採用する。
# worktree 名は feature 名と揃える。同名の worktree が既にあるときだけ mkworktree の機械的命名に任せる。
main() {
  local path feature rc name wt_root
  path=$(pick_space) || exit 0

  case "$path" in
    "$HOME"/Develop/*/repos/*)
      if ! is_main_repo "$path"; then
        feature=$(pick_feature); rc=$?
        case $rc in 0) ;; 1) exit 0 ;; *) exit 1 ;; esac
        name=""
        wt_root="$(dirname "$(dirname "$path")")/worktrees"
        if [ -n "$feature" ] && [ ! -e "$wt_root/$feature" ]; then name="$feature"; fi
        path=$("$(dirname "$0")/mkworktree" "$path" "$name" "$feature") || exit 1
      fi
      ;;
  esac

  [ -n "$path" ] && printf '%s\n' "$path"
}

if [ "${1:-}" = --list ]; then
  list_features "${2:-}"
else
  main
fi

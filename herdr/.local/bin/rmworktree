#!/bin/bash
# 指定した worktree ディレクトリを削除する。mkworktree の逆コマンド。
# 対話プロンプトは持たない。devpick からも Claude からも同じ引数で呼べるようにするため。
# 未コミットの変更がある場合は削除せずに失敗する。捨ててよいときだけ -f を付ける。
# worktree が結びついている feature も、他の worktree から参照されていなければ .specs/.archive へ退避する。
#   完了した feature が溜まると、devpick で feature を選ぶ時に邪魔になるため。
#   .archive は隠しディレクトリなので devpick の一覧に出ない。戻すときは mv する。
#   -k で feature をそのまま残し、-d で退避せず完全に削除する。
# $HOME/Develop/*/worktrees 配下のみを対象にする。repos/ の bare repo は消さないため。
set -euo pipefail

force=()
keep_feature=0
purge_feature=0
while getopts fkd opt; do
  case "$opt" in
    f) force=(--force) ;;
    k) keep_feature=1 ;;
    d) purge_feature=1 ;;
    *) exit 1 ;;
  esac
done
shift $((OPTIND - 1))

arg="${1:?usage: rmworktree [-f] [-k | -d] <worktree-path>}"
[ "$keep_feature" -eq 0 ] || [ "$purge_feature" -eq 0 ] \
  || { echo "-k と -d は同時に指定できません" >&2; exit 1; }

[ -d "$arg" ] || { echo "見つかりません: $arg" >&2; exit 1; }
path="$(cd "$arg" && pwd -P)"

case "$path" in
  "$HOME"/Develop/*/worktrees/*) ;;
  *) echo "worktrees 配下ではありません: $path" >&2; exit 1 ;;
esac

if [ "${#force[@]}" -eq 0 ] && [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
  echo "未コミットの変更があります。捨てる場合は -f を付けてください: $path" >&2
  exit 1
fi

# workspace を閉じるために、削除前に id を引いておく。
ws_id=$(herdr worktree list --cwd "$path" 2>/dev/null \
  | jq -r --arg p "$path" '.result.worktrees[]? | select(.path == $p) | .open_workspace_id // empty')

feature_dir=""
if [ "$keep_feature" -eq 0 ] && [ -e "$path/.specs" ]; then
  feature_dir="$(cd "$path/.specs" && pwd -P)"
  case "$feature_dir" in
    "$HOME"/Develop/.specs/*) ;;
    *) feature_dir="" ;;
  esac
fi

# 他の worktree が同じ feature を指していたら残す。
if [ -n "$feature_dir" ]; then
  for other in "$HOME"/Develop/*/worktrees/*/.specs; do
    [ -e "$other" ] || continue
    [ "$(cd "$other" && pwd -P)" = "$feature_dir" ] || continue
    [ "$(dirname "$other")" != "$path" ] || continue
    feature_dir=""
    break
  done
fi

git -C "$path" worktree remove "${force[@]}" "$path"

# 開いていなくても削除自体は上で完了しているので失敗は無視してよい。
[ -z "$ws_id" ] || herdr workspace close "$ws_id" >/dev/null 2>&1 || true

echo "削除しました: $path"

if [ -n "$feature_dir" ]; then
  if [ "$purge_feature" -eq 1 ]; then
    rm -rf "$feature_dir"
    echo "feature を削除しました: $feature_dir"
  else
    archive_root="$HOME/Develop/.specs/.archive"
    archived="$archive_root/$(basename "$feature_dir")"
    [ ! -e "$archived" ] || archived="$archived-$(date +%Y%m%d%H%M%S)"
    mkdir -p "$archive_root"
    mv "$feature_dir" "$archived"
    echo "feature を退避しました: $archived"
  fi
fi

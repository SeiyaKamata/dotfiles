#!/bin/bash
# 指定した worktree ディレクトリを削除する。mkworktree の逆コマンド。
# 対話プロンプトは持たない。人からも Claude からも同じ引数で呼べるようにするため。
# 未コミットの変更がある場合は削除せずに失敗する。捨ててよいときだけ -f を付ける。
# $HOME/Develop/*/worktrees 配下のみを対象にする。repos/ の bare repo は消さないため。
set -euo pipefail

die() {
  echo "$1" >&2
  exit 1
}

realdir() {
  (cd "$1" && pwd -P)
}

is_dirty() {
  [ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]
}

open_workspace_id() {
  herdr worktree list --cwd "$1" 2>/dev/null \
    | jq -r --arg p "$1" '.result.worktrees[]? | select(.path == $p) | .open_workspace_id // empty'
}

main() {
  local force=() opt arg path ws_id
  while getopts f opt; do
    case "$opt" in
      f) force=(--force) ;;
      *) exit 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  arg="${1:?usage: rmworktree [-f] <worktree-path>}"
  [ -d "$arg" ] || die "見つかりません: $arg"
  path="$(realdir "$arg")"

  case "$path" in
    "$HOME"/Develop/*/worktrees/*) ;;
    *) die "worktrees 配下ではありません: $path" ;;
  esac

  if [ "${#force[@]}" -eq 0 ] && is_dirty "$path"; then
    die "未コミットの変更があります。捨てる場合は -f を付けてください: $path"
  fi

  # 削除すると引けなくなるので、workspace の id は先に調べておく。
  ws_id="$(open_workspace_id "$path")"

  git -C "$path" worktree remove ${force[@]+"${force[@]}"} "$path"
  echo "削除しました: $path"

  # 実行元の pane ごと閉じる場合があるので、他の処理を終えた最後に置く。
  # 開いていなくても削除自体は完了しているので失敗は無視してよい。
  [ -z "$ws_id" ] || herdr workspace close "$ws_id" >/dev/null 2>&1 || true
}

main "$@"

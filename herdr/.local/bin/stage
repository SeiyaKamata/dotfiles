#!/bin/bash
# 実行元の herdr space に、AI の状態からは分からない待ち状態の記号を表示する。AI の稼働状態は herdr が示すのでここでは扱わない。
# 状態名と記号の対応はここだけが持つ。記号を変えるときはこのファイルだけ直す。
# herdr の外で呼ばれても成功で終わる。skill を herdr 以外の端末でも止めないため。
set -euo pipefail

usage="usage: stage <misc|low|pause|complete|qa|selfreview|review|clear>"
name="${1:?$usage}"

case "$name" in
  misc) mark=$'\xef\x83\xb6' ;;
  low) mark=$'\xef\x84\x83' ;;
  pause) mark=$'\xef\x81\x8c' ;;
  complete) mark=$'\xef\x81\x98' ;;
  qa) mark=$'\xef\x81\x8c \xef\x8b\x90' ;;
  selfreview) mark=$'\xef\x81\x8c \xef\x81\xae' ;;
  review) mark=$'\xef\x81\x8c \xef\x81\xb5' ;;
  clear) mark="" ;;
  *)
    echo "$usage" >&2
    exit 1
    ;;
esac

[ -n "${HERDR_WORKSPACE_ID:-}" ] || exit 0

if [ -n "$mark" ]; then
  args=(--token "stage=$mark")
else
  args=(--clear-token stage)
fi

# サイドバーの spaces 欄は space の値、agents 欄は pane の値を参照する。両方に書かないとどちらかに出ない。
herdr workspace report-metadata "$HERDR_WORKSPACE_ID" --source stage "${args[@]}" >/dev/null
herdr pane report-metadata "$HERDR_PANE_ID" --source stage "${args[@]}" >/dev/null

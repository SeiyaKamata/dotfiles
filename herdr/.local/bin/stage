#!/bin/bash
# 実行元の herdr space に、AI の状態からは分からない待ち状態の記号を表示する。AI の稼働状態は herdr が示すのでここでは扱わない。
# 状態名と記号の対応はここだけが持つ。記号を変えるときはこのファイルだけ直す。
# herdr の外で呼ばれても成功で終わる。skill を herdr 以外の端末でも止めないため。
set -euo pipefail

usage="usage: stage <qa|selfreview|review|clear>"
name="${1:?$usage}"

case "$name" in
  qa) mark=Q ;;
  selfreview) mark=S ;;
  review) mark=R ;;
  clear) mark="" ;;
  *)
    echo "$usage" >&2
    exit 1
    ;;
esac

[ -n "${HERDR_WORKSPACE_ID:-}" ] || exit 0

# 状態ごとに色を変えるため、状態名のトークンを分ける。色は config.toml 側でトークンごとに指定する。
args=()
for state in qa selfreview review; do
  if [ "$state" = "$name" ]; then
    args+=(--token "stage_$state=$mark")
  else
    args+=(--clear-token "stage_$state")
  fi
done

# サイドバーの spaces 欄は space の値、agents 欄は pane の値を参照する。両方に書かないとどちらかに出ない。
herdr workspace report-metadata "$HERDR_WORKSPACE_ID" --source stage "${args[@]}" >/dev/null
herdr pane report-metadata "$HERDR_PANE_ID" --source stage "${args[@]}" >/dev/null
